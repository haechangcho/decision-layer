# Copy to .env for this deployment only. Never copy an existing service's .env.
# Empty required values intentionally prevent startup/config rendering.
# Current verified baseline in versions.json. These tags have not been pushed to a registry.
# Load the saved images or replace with approved registry references before installation.
HEARTCUBE_IMAGE=heartcube:poc-a9e8a00
DECISION_LAYER_IMAGE=decision-layer:poc-2a67b18

# New host ports. Container-to-container traffic uses heartcube:4000.
HEARTCUBE_PORT=5103
DECISION_LAYER_PORT=5104
# 127.0.0.1 for SSH-tunnel checks; 0.0.0.0 only after the ports are approved for the proxy/LB.
BIND_ADDRESS=127.0.0.1

# Existing PostgreSQL/DM/DW approved for this deployment.
# Prefer a dedicated read-only Cube account. Record any shared-account exception privately.
WAREHOUSE_TYPE=postgres
WAREHOUSE_HOST=
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=

# New Cube instance only. Do not reuse the existing Cube signing secret.
HEARTCUBE_API_SECRET=
CUBE_INSTANCE=poc

# Existing authentik instance, new application/client for the new Cube.
# Callback URL must resolve to the NEW Cube, not the existing Cube on port 5101.
HEARTCUBE_OIDC_ISSUER=
HEARTCUBE_OIDC_CLIENT_ID=
HEARTCUBE_OIDC_CLIENT_SECRET=
HEARTCUBE_OIDC_REDIRECT_URI=

# Single-instance rehearsal: execution records live in a persistent named volume.
# Optional: replace with a dedicated PostgreSQL app DB URL (not the warehouse reader).
DL_DATABASE_URL=sqlite:////data/decision_layer.db
DL_LOCALE=ko
DL_JOB_WORKERS=2
# Must include the DL_PUBLIC_URL host. 127.0.0.1 is used by the in-container MCP adapter.
DL_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,decision-layer
DL_WEB_URL=http://localhost:5104/ui/

# Decision Layer login (ADR-130). A NEW authentik application, separate from the Cube one.
# Redirect URI to register: {DL_PUBLIC_URL}/auth/callback
DL_PUBLIC_URL=http://localhost:5104
DL_OIDC_ISSUER=
DL_OIDC_CLIENT_ID=
DL_OIDC_CLIENT_SECRET=
DL_ADMIN_GROUPS=dl-poc-admin
DL_USER_GROUPS=dl-poc-guest
# Two different random values of at least 32 characters (e.g. `openssl rand -base64 48`).
# DL_CUBE_TOKEN_SECRET is also given to the new Cube; never reuse HEARTCUBE_API_SECRET.
DL_SESSION_SECRET=
DL_CUBE_TOKEN_SECRET=

# MCP OAuth reuses the DL OIDC app and /auth/callback. No manual token is needed.
# Short-lived tokens; expiry requires signing in again (no refresh-token grant).
DL_MCP_ACCESS_TOKEN_SECONDS=3600
DL_MCP_REDIRECT_HOSTS=localhost,127.0.0.1,::1,claude.ai,claude.com,chatgpt.com,chat.openai.com
