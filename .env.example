# Cube REST API
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_INSTANCE=local
# Service credentials for requests without a bearer token (local/dev only): a JWT signed with the Cube API
# secret (Cube OSS default checkAuth), carrying CUBE_SERVICE_GROUPS as cube_groups/cubeGroups.
CUBE_API_SECRET=
CUBE_SERVICE_GROUPS=
# Optional Cube auth mode: token | api_secret | none (none is development-only)
CUBE_AUTH_METHOD=
# Local/dev only: allow requests without Authorization to use the service credentials above.
# Leave unset in any shared deployment — every such request would share one identity and its runs.
DL_ALLOW_SERVICE_CREDENTIALS=false
# Local trusted-user deployment only. Shared mode fails closed until its security gates ship.
DL_DEPLOYMENT_MODE=local
# Exact HTTP Host/Origin hostnames, for loopback and the local Compose proxy only.
# This is not authentication; do not expose the local deployment to other users.
DL_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,api
# Additional exact provider endpoints approved by the operator (comma-separated).
# Source testing/editing cannot send credentials to arbitrary URLs.
DL_SOURCE_ALLOWED_URLS=
# Authenticated subjects allowed to edit/publish organization Recipes (comma-separated).
DL_RECIPE_EDITORS=
DL_RECIPE_PUBLISHERS=
# Run storage: sqlite:///path (default: ./data/decision_layer.db) | postgresql://user:pass@host/db | memory
DL_DATABASE_URL=
# Separate permission to edit Cube source settings. Keep outside source control.
DL_SOURCE_ADMIN_TOKEN=
# Required only when saving a Cube API secret in the app; generate with Fernet.generate_key().
# Keep stable and outside the database/backups, or saved secrets become unreadable.
DL_SOURCE_CONFIG_KEY=
# Directory of Recipe YAML files (organisation-specific; none by default). Example: examples/complete-journey/recipes
DL_RECIPES_DIR=
# Default message language when the request sends no supported Accept-Language (en, ko)
DL_LOCALE=en
# MCP response links point to the Web app; change for your deployment.
DL_WEB_URL=http://localhost:3000
# Seconds a request waits for its analysis before answering 202 (then poll GET /runs/{id}/result)
DL_REQUEST_WAIT_SECONDS=25
DL_JOB_WORKERS=4
# Public Method proposal destination; drafts are reviewed and submitted by the user.
DL_ISSUE_REPOSITORY=haechangcho/decision-layer
# Server-owned execution boundaries. All-period queries require explicit opt-in.
# Period and row limits are not warehouse scan-cost guarantees; cancellation is provider-dependent.
DL_EXECUTION_POLICY={"allow_all":false,"max_period_days":366,"deadline_seconds":120,"max_queries":30,"max_result_rows":50000}

# Reviewed operator-owned Method assets; imports execute trusted Python at startup.
# Install modules in the API/worker environment first. No HTTP code upload.
# Recommended: one project with decision-layer.yaml and Python/Skill definitions.
# DL_PROJECT_DIR=/opt/my_team
# Compatibility: separately installed module exports.
# DL_METHOD_MODULES=my_team.methods
# DL_SKILLS_DIR=/opt/decision-layer/skills

# Optional trusted local operator Method/Skill editor. Python checks/publication execute code.
DL_ALLOW_METHOD_EDITING=false
# Compose stores immutable published modules and drafts under its existing data volume.
DL_METHOD_ASSETS_DIR=
# Separate from Recipe roles: a Method publisher can execute trusted Python on the host.
DL_METHOD_EDITORS=
DL_METHOD_PUBLISHERS=
