# Cube REST API
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_INSTANCE=local
# Service credentials for requests without a bearer token (local/dev only): a JWT signed with the Cube API
# secret (Cube OSS default checkAuth), carrying CUBE_SERVICE_GROUPS as cube_groups/cubeGroups.
CUBE_API_SECRET=
CUBE_SERVICE_GROUPS=
# Optional Cube auth mode: token | api_secret | none (none is development-only)
CUBE_AUTH_METHOD=
# Local/dev only: allow requests without Authorization to use the service credentials above.
# Leave unset in any shared deployment — every such request would share one identity and its runs.
DL_ALLOW_SERVICE_CREDENTIALS=true
# Run storage: sqlite:///path (default: ./data/decision_layer.db) | postgresql://user:pass@host/db | memory
DL_DATABASE_URL=
# Separate permission to edit Cube source settings. Keep outside source control.
DL_SOURCE_ADMIN_TOKEN=
# Required only when saving a Cube API secret in the app; generate with Fernet.generate_key().
# Keep stable and outside the database/backups, or saved secrets become unreadable.
DL_SOURCE_CONFIG_KEY=
# Directory of Recipe YAML files (organisation-specific; none by default). Example: examples/complete-journey/recipes
DL_RECIPES_DIR=
# Default message language when the request sends no supported Accept-Language (en, ko)
DL_LOCALE=en
# Seconds a request waits for its analysis before answering 202 (then poll GET /runs/{id}/result)
DL_REQUEST_WAIT_SECONDS=25
DL_JOB_WORKERS=4
