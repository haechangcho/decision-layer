FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir '.[metricflow]'
COPY examples/complete-journey/dbt /project
ENV DBT_PROJECT_DIR=/project DBT_PROFILES_DIR=/project DBT_SEND_ANONYMOUS_USAGE_STATS=false
RUN dbt parse --project-dir /project --profiles-dir /project
CMD ["uvicorn", "decision_layer.semantic.providers.metricflow.gateway:create_gateway", "--factory", "--host", "0.0.0.0", "--port", "4100"]
